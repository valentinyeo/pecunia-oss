{
  "name": "@pecunia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./mcp-worker": {
      "types": "./src/mcp-worker.ts",
      "import": "./src/mcp-worker.ts",
      "default": "./src/mcp-worker.ts"
    },
    "./rpc-worker": {
      "types": "./src/rpc-worker.ts",
      "import": "./src/rpc-worker.ts",
      "default": "./src/rpc-worker.ts"
    }
  },
  "scripts": {
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "check": "pnpm run typecheck",
    "lint": "oxlint --format agent ."
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@pecunia/capability": "workspace:*",
    "@pecunia/core": "workspace:*",
    "@pecunia/database": "workspace:*",
    "@pecunia/flags": "workspace:*",
    "@pecunia/site": "workspace:*",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
