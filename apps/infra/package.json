{
  "name": "@pecunia/infra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "check": "pnpm run typecheck",
    "test": "vitest run",
    "plan": "alchemy plan",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "plan:pecunia": "PECUNIA_STANDALONE=true alchemy plan pecunia.run.ts",
    "deploy:pecunia": "PECUNIA_STANDALONE=true alchemy deploy pecunia.run.ts",
    "destroy:pecunia": "PECUNIA_STANDALONE=true alchemy destroy pecunia.run.ts",
    "predev": "pnpm --filter @pecunia/site generate",
    "dev": "alchemy dev",
    "logs": "alchemy logs",
    "lint": "oxlint --format agent ."
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@alchemy.run/drizzle": "2.0.0-beta.87",
    "@effect/platform-node": "4.1.4",
    "@pecunia/site": "workspace:*",
    "@pecunia/turbo-cache": "workspace:*",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.4",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
