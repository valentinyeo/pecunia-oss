{
  "extends": "../../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts", "*.config.ts", "stylex.ts"],
  "compilerOptions": {
    "plugins": [
      {
        "name": "@effect/language-service",
        "allowedExperimentalApis": [
          "@effect/ui/Command",
          "@effect/ui/Head",
          "@effect/ui/Query",
          "@effect/ui/Renderer",
          "@effect/ui/Route",
          "@effect/ui/Router",
          "@effect/ui/UiSchema",
          "@effect/ui/html/BrowserHost",
          "@effect/ui/html/BrowserRouter",
          "@effect/ui/html/Html",
          "@effect/ui/html/HtmlHead",
          "@effect/ui/html/HtmlHydrate",
          "@effect/ui/html/HtmlServer",
          "@effect/ui/html/testing/HtmlLocator",
          "@effect/ui/html/testing/HtmlPlay",
          "@effect/ui/testing/Locator",
          "@effect/ui/testing/TestHost"
        ],
        "allowedUnstableApis": [
          "@effect/platform-node-shared/NodeCrypto",
          "@effect/platform-node/NodeFileSystem",
          "@effect/platform-node/NodePath",
          "@effect/platform-node/NodeServices",
          "@effect/vitest",
          "effect/Arbitrary",
          "effect/FileSystem",
          "effect/Path",
          "effect/ai/McpProtocol",
          "effect/ai/McpServer",
          "effect/crypto/Digest",
          "effect/http/FetchHttpClient",
          "effect/http/HttpRouter",
          "effect/http/HttpServerRequest",
          "effect/http/HttpServerResponse",
          "effect/process/ChildProcess",
          "effect/process/ChildProcessSpawner",
          "effect/reactivity/AsyncResult",
          "effect/rpc/RpcClient",
          "effect/rpc/RpcSerialization",
          "effect/rpc/RpcServer"
        ]
      }
    ],
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": ["node", "vite/client"]
  }
}
