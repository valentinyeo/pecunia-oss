{
  "name": "@pecunia/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#backend": {
      "development": "./src/dev/backend.ts"
    },
    "#devtools-overlay": {
      "development": "./src/dev/client/entry.ts",
      "default": "./src/client/no-devtools.ts"
    }
  },
  "scripts": {
    "predev": "pnpm --filter @pecunia/site generate",
    "dev": "portless rat-stack vite dev",
    "typecheck": "effect-tsrs diagnostics --project tsconfig.json --strict --type-check",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.json",
    "typecheck:fast": "tsrs --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "vite build",
    "check": "pnpm run typecheck",
    "lint": "oxlint --format agent ."
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "@effect/platform-browser": "4.1.4",
    "@foldkit/ui": "0.170.0",
    "@pecunia/access": "workspace:*",
    "@pecunia/ai-sorting": "workspace:*",
    "@pecunia/auth": "workspace:*",
    "@pecunia/bank-lines": "workspace:*",
    "@pecunia/capability": "workspace:*",
    "@pecunia/core": "workspace:*",
    "@pecunia/devtools": "workspace:*",
    "@pecunia/investments": "workspace:*",
    "@pecunia/motion": "workspace:*",
    "@pecunia/settings": "workspace:*",
    "@pecunia/site": "workspace:*",
    "@stylexjs/stylex": "0.19.2",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.4",
    "foldkit": "0.170.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.4",
    "@effect/vitest": "4.1.4",
    "@foldkit/devtools": "0.170.0",
    "@foldkit/markdown": "0.15.0",
    "@foldkit/vite-plugin": "0.29.0",
    "@stylexjs/unplugin": "0.19.2",
    "@types/node": "24.19.2",
    "jsdom": "31.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
