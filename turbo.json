{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "remoteCache": { "signature": true },
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    },
    "typecheck:tsc": {
      "dependsOn": ["^typecheck:tsc"],
      "outputs": []
    },
    "//#typecheck:tsc-scripts": {
      "outputs": []
    },
    "@pecunia/site#typecheck:tsc": {
      "dependsOn": ["@pecunia/site#generate", "^typecheck:tsc"],
      "outputs": []
    },
    "@pecunia/web#typecheck:tsc": {
      "dependsOn": ["^build", "^typecheck:tsc"],
      "outputs": []
    },
    "typecheck:fast": {
      "dependsOn": ["^typecheck:fast"],
      "outputs": []
    },
    "//#typecheck:fast-scripts": {
      "outputs": []
    },
    "@pecunia/site#typecheck:fast": {
      "dependsOn": ["@pecunia/site#generate", "^typecheck:fast"],
      "outputs": []
    },
    "@pecunia/web#typecheck:fast": {
      "dependsOn": ["^build", "^typecheck:fast"],
      "outputs": []
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "test": {
      "dependsOn": ["build", "//#test:guards"],
      "outputs": []
    },
    "//#test:guards": {
      "outputs": []
    },
    "//#lint": {
      "dependsOn": ["@pecunia/site#generate"],
      "outputs": []
    },
    "//#typecheck-scripts": {
      "outputs": []
    },
    "//#lockfile:check": {
      "cache": false,
      "outputs": []
    },
    "check": {
      "dependsOn": [
        "//#lockfile:check",
        "typecheck",
        "//#lint",
        "//#typecheck-scripts"
      ],
      "outputs": []
    },
    "@pecunia/site#generate": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": [
        "src/bundled-content.generated.ts",
        "src/interest-pages.generated.ts",
        "src/rat-icons.generated.ts",
        "dist/content/**",
        "dist/reader-source.json"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.brain/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/VISION.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vendor/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/*.config.ts",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.generated.ts",
        "!$TURBO_ROOT$/packages/**/*.generated.ts",
        "!$TURBO_ROOT$/tools/oxlint/anti-slop/**"
      ]
    },
    "@pecunia/site#typecheck": {
      "dependsOn": ["@pecunia/site#generate", "^typecheck"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.brain/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/VISION.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vendor/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/*.config.ts",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.generated.ts",
        "!$TURBO_ROOT$/packages/**/*.generated.ts",
        "!$TURBO_ROOT$/tools/oxlint/anti-slop/**"
      ]
    },
    "@pecunia/site#build": {
      "dependsOn": ["@pecunia/site#generate", "^build"],
      "outputs": ["dist/**", "!dist/content/**", "!dist/reader-source.json"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.brain/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/VISION.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vendor/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/*.config.ts",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.generated.ts",
        "!$TURBO_ROOT$/packages/**/*.generated.ts",
        "!$TURBO_ROOT$/tools/oxlint/anti-slop/**"
      ]
    },
    "@pecunia/infra#test": {
      "dependsOn": ["^build", "@pecunia/web#build", "@pecunia/web#test"],
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apps/web/src/**"]
    },
    "@pecunia/web#typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    },
    "@pecunia/site#test": {
      "dependsOn": ["build"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.brain/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/VISION.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vendor/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/*.config.ts",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.generated.ts",
        "!$TURBO_ROOT$/packages/**/*.generated.ts",
        "!$TURBO_ROOT$/tools/oxlint/anti-slop/**"
      ]
    },
    "@pecunia/site#check": {
      "dependsOn": [
        "//#lockfile:check",
        "typecheck",
        "//#lint",
        "//#typecheck-scripts"
      ],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.brain/**",
        "$TURBO_ROOT$/skills/**",
        "$TURBO_ROOT$/assets/**",
        "$TURBO_ROOT$/AGENTS.md",
        "$TURBO_ROOT$/VISION.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/vendor/README.md",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/scripts/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/*.config.ts",
        "!$TURBO_ROOT$/apps/**/node_modules/**",
        "!$TURBO_ROOT$/packages/**/node_modules/**",
        "!$TURBO_ROOT$/apps/**/dist/**",
        "!$TURBO_ROOT$/packages/**/dist/**",
        "!$TURBO_ROOT$/apps/**/.turbo/**",
        "!$TURBO_ROOT$/packages/**/.turbo/**",
        "!$TURBO_ROOT$/apps/**/*.generated.ts",
        "!$TURBO_ROOT$/packages/**/*.generated.ts",
        "!$TURBO_ROOT$/tools/oxlint/anti-slop/**"
      ]
    }
  }
}
